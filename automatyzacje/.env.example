# WSPÓLNY plik sekretów dla WSZYSTKICH automatyzacji (wz, mm, produkty, ...).
# Skopiuj do automatyzacje/.env (BEZ .example) i wpisz prawdziwe wartości —
# jedno miejsce na dane logowania do bazy i ERP. .env jest w .gitignore.
#
# Jak to działa: każda automatyzacja najpierw próbuje swojego LOKALNEGO
# <typ>/.env (np. automatyzacje/wz/.env), a brakujące wartości dobiera z TEGO
# wspólnego pliku. Lokalny .env jest więc opcjonalny — służy tylko do nadpisań
# per automatyzacja. W typowej instalacji wystarczy ten jeden wspólny plik.

DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=

ERP_LOGIN=
ERP_PASSWORD=

HEADLESS=true

# --- Powiadomienia o ROZBIEŻNOŚCIACH ERP↔worek (mail) ---
# Do worka tylko dopisujemy; gdy scrape pokaże, że dane w ERP różnią się od tego,
# co już jest w bazie, idzie zbiorczy mail (lib-wspolne/powiadom.js). BEZ tych
# wartości mail jest pomijany (rozbieżności i tak trafiają do logu/run-log.jsonl).
# Sekrety TYLKO tutaj (repo de facto publiczne). Wymaga też: npm i nodemailer.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false        # true dla portu 465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=               # domyślnie = SMTP_USER
# POWIADOM_TO=l.dutkiewicz@savpol.pl

# Uwaga: zmienne specyficzne per uruchomienie (FILTER_DATE, MAX_DOCS,
# MM_DOC_TYPE_ID, SKUS itp.) ustawiaj w wrapperach serwer/uruchom.bat danej
# automatyzacji albo w jej lokalnym .env — NIE tutaj, żeby nie mieszać ich
# między typami dokumentów.
