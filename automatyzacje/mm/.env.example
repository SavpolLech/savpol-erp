# Skopiuj ten plik do .env (BEZ .example) i wpisz prawdziwe wartości.
# .env jest w .gitignore — nigdy nie trafi do commita. Wpisuj dane
# dostępowe TYLKO tutaj, nie w czacie z Claude i nie nigdzie indziej w repo.

DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=

ERP_LOGIN=
ERP_PASSWORD=

# Opcjonalne — mają rozsądne wartości domyślne w scrape.js, ustaw tylko żeby nadpisać.
# MAX_DOCS=5           # TRYB OSTROŻNY (próbka). Po zatwierdzeniu próbki: 900.
# MIN_SESSION_MINUTES=30
# MAX_SESSION_MINUTES=60
# BATCH_SIZE=15
# HEADLESS=true
# FILTER_DATE=2026-08-03
# USE_DOC_TYPE_FILTER=false   # dla MM domyślnie false (URL już zawęża do przesunięć)
# MM_DOC_TYPE_FILTER_LABEL=MM
# MM_LIST_URL=https://erp.savpol.pl/pl/przesuniecia-magazynowe/csdocsheaders4goodstransfers
