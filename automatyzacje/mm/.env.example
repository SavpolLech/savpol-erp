# Ten LOKALNY .env jest OPCJONALNY. Dane logowania do bazy i ERP trzymamy
# w JEDNYM wspólnym pliku: automatyzacje/.env (patrz automatyzacje/.env.example).
# scrape.js czyta najpierw ten lokalny plik (jeśli istnieje), a brakujące
# wartości dobiera ze wspólnego. Twórz ten plik tylko, jeśli MM ma mieć INNE
# dane niż reszta automatyzacji — inaczej wystarczy wspólny automatyzacje/.env.
#
# Sekrety (odkomentuj i wpisz TYLKO jeśli nadpisujesz wspólne):
# DB_HOST=
# DB_PORT=1433
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# ERP_LOGIN=
# ERP_PASSWORD=

# Opcjonalne — mają rozsądne wartości domyślne w scrape.js, ustaw tylko żeby nadpisać.
# MAX_DOCS=5           # TRYB OSTROŻNY (próbka). Po zatwierdzeniu próbki: 900.
# MIN_SESSION_MINUTES=30
# MAX_SESSION_MINUTES=60
# BATCH_SIZE=15
# HEADLESS=true
# FILTER_DATE=2026-08-03
# USE_DOC_TYPE_FILTER=true    # domyślnie true — używa zapisanego w ERP filtra "MM"
#                             # (serwerowo zawęża do przesunięć MM, mniej stron).
#                             # Ustaw false, jeśli filtr w ERP zniknie/zmieni nazwę.
# MM_DOC_TYPE_FILTER_LABEL=MM # nazwa zapisanego filtra w ERP
# MM_DOC_TYPE_ID=269000798    # "Przesunięcie magazynowe" — filtr po naszej stronie
#                             # (druga linia obrony, działa niezależnie od filtra ERP)
# MM_LIST_URL=https://erp.savpol.pl/pl/przesuniecia-magazynowe/csdocsheaders4goodstransfers
