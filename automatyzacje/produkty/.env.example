# Skopiuj ten plik do .env (BEZ .example) i wpisz prawdziwe wartości.
# .env jest w .gitignore — nigdy nie trafi do commita. Wpisuj dane
# dostępowe TYLKO tutaj, nie w czacie z Claude i nie nigdzie indziej w repo.
#
# Jeśli tego pliku nie utworzysz, scrape.js użyje danych logowania z
# ../wz/.env (te same konto ERP) — więc przy jednej maszynie nie musisz
# duplikować hasła.

ERP_LOGIN=
ERP_PASSWORD=

# Opcjonalne — rozsądne wartości domyślne są w scrape.js.
# HEADLESS=true
# SKUS=0000031
# CATALOG_URL=https://erp.savpol.pl/pl/katalog/csitems/

# Docelowo (zapis do bazy `worek`, na razie nieużywane — scraper pisze do plików):
# DB_HOST=
# DB_PORT=1433
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
