# Ten LOKALNY .env jest OPCJONALNY. Dane logowania trzymamy w jednym wspólnym
# pliku: automatyzacje/.env (patrz automatyzacje/.env.example). Jeśli tego
# lokalnego pliku nie utworzysz, scrape.js weźmie dane ze wspólnego
# automatyzacje/.env — więc nie musisz duplikować hasła. Twórz go tylko, jeśli
# produkty mają mieć INNE dane niż reszta automatyzacji.

ERP_LOGIN=
ERP_PASSWORD=

# Opcjonalne — rozsądne wartości domyślne są w scrape.js.
# HEADLESS=true
# SKUS=0000031
# CATALOG_URL=https://erp.savpol.pl/pl/katalog/csitems/

# Docelowo (zapis do bazy `worek`, na razie nieużywane — scraper pisze do plików):
# DB_HOST=
# DB_PORT=1433
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
