# Lokalne ustawienia Claude Code — zawierają ścieżki specyficzne dla maszyny
# (katalog użytkownika, scratchpad sesji), więc nie wchodzą do repo.
# Skille w .claude/skills/ są wersjonowane celowo.
.claude/settings.local.json

# Historie faktur z ERP — dane handlowe, trzymane lokalnie w Downloads
historia_faktur_*.csv
cross_sell_*.csv

# Sekrety automatyzacji (hasła do bazy, connection stringi) — repo jest
# de facto publiczne (linki raw dla marketingu), więc to NIGDY nie wchodzi
# do commita. .env.example (bez realnych wartości) zostaje wersjonowany.
automatyzacje/**/.env
automatyzacje/**/.env.*
!automatyzacje/**/.env.example

# Zależności Node i lokalne wyniki testowe (dane WZ z ERP — nie wchodzą do repo)
automatyzacje/**/node_modules/
automatyzacje/**/results.json
