# Lokalne ustawienia Claude Code — zawierają ścieżki specyficzne dla maszyny
# (katalog użytkownika, scratchpad sesji), więc nie wchodzą do repo.
# Skille w .claude/skills/ są wersjonowane celowo.
.claude/settings.local.json

# Historie faktur z ERP — dane handlowe, trzymane lokalnie w Downloads
historia_faktur_*.csv
cross_sell_*.csv

# Sekrety automatyzacji (hasła do bazy, connection stringi) — repo jest
# de facto publiczne (linki raw dla marketingu), więc to NIGDY nie wchodzi
# do commita. .env.example (bez realnych wartości) zostaje wersjonowany.
automatyzacje/**/.env
automatyzacje/**/.env.*
!automatyzacje/**/.env.example

# Zależności Node i lokalne wyniki testowe (dane WZ z ERP — nie wchodzą do repo)
automatyzacje/**/node_modules/
automatyzacje/**/results.json
automatyzacje/**/results-*.csv

# Wyniki scrapera produktów (dane handlowe z ERP: opisy, ceny) — lokalnie,
# nie do repo. Cały katalog wynik/ (CSV + JSON pełnego rekordu produktu).
automatyzacje/**/wynik/

# Wygenerowany artefakt (generate-test-tables.js odtwarza go z bazy) — nie
# ma sensu wersjonować, łatwo się rozjedzie z prawdziwym schematem
automatyzacje/**/schema-test-tables.json

# Plik-blokada jednej aktywnej sesji scrapera — czysto lokalny stan procesu
automatyzacje/**/.scrape.lock
# Globalna blokada orkiestratora (dobij-wszystko.js) — jeden scraper na ERP naraz
automatyzacje/.scrapery.lock
# Log lokalnego biegu orkiestratora (launcher) — czysto lokalny
automatyzacje/dobij-wszystko.log
# Lista ID do ręcznego doscrapowania produktów — wejście od Michała, nie do repo
automatyzacje/produkty/lista-id.txt

# Zrzuty ekranu do debugowania — mogą zawierać dane handlowe z ekranu ERP
automatyzacje/**/debug-*.png

# Stan postępu i dziennik przebiegów CELOWO WERSJONOWANE (od 2026-09-10) —
# automatyzacja na serwerze sama je commituje/pushuje po każdym przebiegu
# (lib/git-log-push.js), żeby było widać co się dzieje bez dostępu do
# serwera. Zawierają tylko numery dokumentów i liczniki, nie dane handlowe
# (kwoty, kontrahenci) — te zostają wyłącznie w CSV, dalej ignorowanym wyżej.

# Kolekcja sucharow z Familiady - cudza tworczosc, repo jest de facto publiczne
suchary.txt


# Log miesiecznego przeliczenia bazy powiazan cross-sell
automatyzacje/cross-sell/*.log

# Logi z ręcznych/backfillowych biegów scrapera produktów — czysto lokalne
automatyzacje/produkty/*.log
